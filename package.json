{
  "name": "projet-o-movies-back",
  "version": "1.0.0",
  "description": "#Conseil d'utilisation",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22.23.0 <25"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "lint": "eslint . --ext .js --max-warnings=0",
    "db:init": "npm run db:data && npm run db:function && npm run db:index && npm run db:seeding",
    "db:data": "npx dotenv -e .env -- sh -c 'psql \"$PG_URL\" -f data/01.data.sql'",
    "db:index": "npx dotenv -e .env -- sh -c 'psql \"$PG_URL\" -f data/03.indexOnTmdb_id.sql'",
    "db:function": "npx dotenv -e .env -- sh -c 'psql \"$PG_URL\" -f data/02.function.sql'",
    "db:seeding": "npx dotenv -e .env -- sh -c 'psql \"$PG_URL\" -f data/04.seeding.sql'",
    "test": "mocha --recursive"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.18.0",
    "axios-cache-interceptor": "^1.12.0",
    "bcrypt": "^6.0.0",
    "chai": "^6.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "email-validator": "^2.0.4",
    "express": "^5.2.1",
    "express-jsdoc-swagger": "^1.8.0",
    "express-rate-limit": "^8.5.2",
    "jsdoc": "^4.0.5",
    "jsonwebtoken": "^9.0.3",
    "mocha": "^11.7.6",
    "pg": "^8.22.0",
    "redis": "^5.12.1",
    "sanitize-html": "^2.17.5",
    "sequelize": "^6.37.8",
    "sinon": "^22.0.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.4"
  }
}
