{
  "name": "projet-o-movies-back",
  "version": "1.0.0",
  "description": "#Conseil d'utilisation",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "^22.19.0"
  },
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "lint": "eslint . --ext .js --max-warnings=0",
    "db:init": "npm run db:data && npm run db:function && npm run db:index && npm run db:seeding",
    "db:data": "npx dotenv -e .env -- sh -c 'psql \"$PG_URL\" -f data/01.data.sql'",
    "db:index": "npx dotenv -e .env -- sh -c 'psql \"$PG_URL\" -f data/03.indexOnTmdb_id.sql'",
    "db:function": "npx dotenv -e .env -- sh -c 'psql \"$PG_URL\" -f data/02.function.sql'",
    "db:seeding": "npx dotenv -e .env -- sh -c 'psql \"$PG_URL\" -f data/04.seeding.sql'",
    "test": "mocha --recursive"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.16.0",
    "axios-cache-interceptor": "^1.12.0",
    "bcrypt": "^6.0.0",
    "chai": "^6.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "email-validator": "^2.0.4",
    "express": "^5.2.1",
    "express-jsdoc-swagger": "^1.8.0",
    "express-rate-limit": "^8.5.0",
    "jsdoc": "^4.0.5",
    "jsonwebtoken": "^9.0.3",
    "mocha": "^11.7.5",
    "pg": "^8.21.0",
    "proxyquire": "^2.1.3",
    "redis": "^5.12.1",
    "sanitize-html": "^2.17.3",
    "sequelize": "^6.37.8",
    "sinon": "^22.0.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3"
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript": "^7.0.5",
      "diff": "^8.0.4"
    },
    "onlyBuiltDependencies": [
      "@scarf/scarf",
      "bcrypt"
    ]
  }
}
